{
  "name": "voice-khata",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run report:bundle",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "report:bundle": "esbuild scripts/bundleReport.ts --bundle --platform=node --outfile=scripts/bundleReport.cjs && node scripts/bundleReport.cjs",
    "preview": "vite preview",
    "audit:pwa": "esbuild scripts/auditPwa.ts --bundle --platform=node --outfile=scripts/auditPwa.cjs && node scripts/auditPwa.cjs",
    "accuracy": "esbuild scripts/accuracy.ts --bundle --platform=node --outfile=scripts/accuracy.cjs && node scripts/accuracy.cjs",
    "benchmark": "esbuild scripts/perfBenchmark.ts --bundle --platform=node --outfile=scripts/perfBenchmark.cjs && node scripts/perfBenchmark.cjs",
    "test:e2e": "playwright test",
    "test": "esbuild scripts/testParser.ts --bundle --platform=node --outfile=scripts/testParser.cjs && node scripts/testParser.cjs && vitest run --coverage",
    "test:vitest": "vitest run"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@vitest/coverage-v8": "^1.6.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^0.20.5",
    "vitest": "^1.6.0"
  }
}
