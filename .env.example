# ==============================================================================
# Voice Khata (आवाज़ खाता) - Environment Variables Configuration
# ==============================================================================
# NOTE: Voice Khata operates 100% offline by default using the browser's built-in
# Web Speech API and client-side rule-based Indic NLP parser.
#
# Serverless ASR proxy credentials below are OPTIONAL fallbacks used only when
# serverless cloud ASR (Sarvam AI or Bhashini) is selected by the user.
# These keys are read exclusively in serverless functions and NEVER exposed to the client.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Sarvam AI (Saarika v2 Indic Speech-to-Text) - Primary Serverless Provider
# Get your API key from https://www.sarvam.ai/
# ------------------------------------------------------------------------------
SARVAM_API_KEY=your_sarvam_api_key_here

# ------------------------------------------------------------------------------
# 2. Bhashini AI (Digital India ASR) - Secondary / Alternate Provider
# Get your credentials from https://bhashini.gov.in/ulca/
# ------------------------------------------------------------------------------
BHASHINI_API_KEY=your_bhashini_api_key_here
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_PIPELINE_ID=your_bhashini_pipeline_id_here

# ------------------------------------------------------------------------------
# 3. Serverless Proxy Rate Limiting Configuration
# Max ASR proxy requests allowed per client IP per minute (default: 30)
# ------------------------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=30
